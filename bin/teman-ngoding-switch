#!/bin/bash
# Ganti akun CLI (versi root yang dipakai Teman Ngoding).
#   teman-ngoding-switch [claude|gemini|codex|opencode]
# Halaman login dibuka di Chrome milik user, lalu status Teman Ngoding diperbarui.

agent="${1:-claude}"

as_root() {
    sudo env \
        HOME=/root \
        PATH="/usr/local/lib/teman-ngoding/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin" \
        BROWSER=/usr/local/lib/teman-ngoding/open-in-user-chrome \
        TEMAN_NGODING_USER="$USER" \
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" DISPLAY="$DISPLAY" \
        "$@"
}

gemini_provider() {
    # Set metode login Antigravity CLI: "gemini" = API key, kosong = akun Google
    # (modelProvider di /root/.gemini/antigravity-cli/settings.json)
    as_root python3 -c '
import json, os, sys
path = "/root/.gemini/antigravity-cli/settings.json"
try:
    data = json.load(open(path))
except (OSError, ValueError):
    data = {}
if sys.argv[1]:
    data["modelProvider"] = sys.argv[1]
else:
    data.pop("modelProvider", None)
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(data, open(path, "w"), indent=2)
' "$1"
}

ask_key() {
    # Baca API key tanpa menampilkannya di layar
    read -rsp "Tempel API key lalu Enter: " key
    echo
    [ -n "$key" ]
}

case "$agent" in
    claude)
        echo "🔁 Ganti akun Claude Code (Teman Ngoding)"
        echo "   Halaman login akan terbuka di Chrome."
        echo "   Kalau perlu, pilih / login akun lain dulu di claude.ai."
        echo
        as_root bash -c '/root/.local/bin/claude auth login; rc=$?; echo; /root/.local/bin/claude auth status --text; exit $rc'
        status=$?
        ;;
    gemini)
        echo "🔁 Ganti akun Gemini / Antigravity CLI (Teman Ngoding)"
        echo
        echo "  1) Login dengan akun Google (Antigravity)"
        echo "  2) Pakai API key dari https://aistudio.google.com/apikey"
        read -rp "Pilih [1/2]: " choice
        if [ "$choice" = "2" ]; then
            if ask_key; then
                printf 'GEMINI_API_KEY=%s\n' "$key" | as_root bash -c 'umask 077; mkdir -p /root/.gemini; cat > /root/.gemini/.env'
                gemini_provider gemini
                echo "✅ API key disimpan di /root/.gemini/.env"
                status=0
            else
                status=1
            fi
        else
            gemini_provider ""
            echo "Antigravity CLI akan terbuka dan meminta login di Chrome."
            echo "Kalau masih masuk dengan akun lama, ketik /logout lalu buka lagi lewat maskot."
            echo "Setelah berhasil login, ketik /quit."
            echo
            as_root bash -c 'cd /root && /root/.local/bin/agy'
            status=$?
        fi
        ;;
    codex)
        echo "🔁 Ganti akun Codex CLI (Teman Ngoding)"
        echo
        echo "  1) Login dengan akun ChatGPT (halaman login terbuka di Chrome)"
        echo "  2) Pakai OpenAI API key"
        read -rp "Pilih [1/2]: " choice
        as_root codex logout >/dev/null 2>&1
        if [ "$choice" = "2" ]; then
            if ask_key; then
                printf '%s' "$key" | as_root codex login --with-api-key
                status=$?
            else
                status=1
            fi
        else
            as_root codex login
            status=$?
        fi
        echo
        as_root codex login status
        ;;
    opencode)
        echo "🔁 Ganti akun OpenCode (Teman Ngoding)"
        echo "   Pilih provider (mis. Anthropic, OpenAI, Google) lalu ikuti petunjuknya."
        echo
        as_root opencode auth login
        status=$?
        echo
        as_root opencode auth list
        ;;
    *)
        echo "Karakter tidak dikenal: $agent" >&2
        status=2
        ;;
esac

systemctl start teman-ngoding-status.service 2>/dev/null

echo
if [ "$status" -eq 0 ]; then
    echo "✅ Selesai! Akun Teman Ngoding sudah diperbarui."
else
    echo "⚠️  Login tidak selesai (kode $status)."
fi
read -rp "Tekan Enter untuk menutup..."
