#!/bin/bash
# Dipanggil oleh aplikasi "Teman Ngoding" (dijalankan sebagai user desktop).
#   teman-ngoding-launch [claude|gemini|codex|opencode]
# - Kalau maskot sedang mati / sedang pamit: nyalakan lagi.
# - Kalau sedang hidup: buka CLI karakter tersebut (root) di terminal. Tanpa
#   argumen, dipakai karakter yang sedang aktif di maskot (default: claude).
UUID="teman-ngoding@yandi"
FLAG="${XDG_CACHE_HOME:-$HOME/.cache}/teman-ngoding-was-off"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/teman-ngoding.json"

agent="$1"
if [ -z "$agent" ]; then
    state="$(gnome-extensions info "$UUID" 2>/dev/null | sed -n 's/^ *State: //p')"
    if [ -z "$state" ]; then
        # Belum logout/login sejak pasang: pakai jembatan lewat UUID lama (lihat install.sh)
        UUID="claude-buddy@yandi"
        state="$(gnome-extensions info "$UUID" 2>/dev/null | sed -n 's/^ *State: //p')"
        [ -d "$HOME/.local/share/gnome-shell/extensions/$UUID" ] || state=""
    fi
    if [ -z "$state" ]; then
        # GNOME belum mengenali ekstensinya (baru dipasang, belum logout/login):
        # maskot belum bisa dinyalakan, tapi CLI tetap dibuka
        notify-send -a "Teman Ngoding" -i teman-ngoding "Teman Ngoding" \
            "Logout lalu login sekali supaya maskotnya muncul. Sementara ini CLI-nya dibuka dulu." 2>/dev/null
    elif [ -e "$FLAG" ] || [ "$state" != "ACTIVE" ]; then
        # kalau masih dalam animasi pamit, matikan dulu lalu nyalakan lagi
        [ "$state" = "ACTIVE" ] && gnome-extensions disable "$UUID"
        if gnome-extensions enable "$UUID"; then
            exit 0
        fi
    fi
    agent="$(sed -n 's/.*"character" *: *"\([a-z]*\)".*/\1/p' "$STATE" 2>/dev/null)"
fi

case "$agent" in
    claude) title="Claude Code" ;;
    gemini) title="Gemini CLI" ;;
    codex) title="Codex CLI" ;;
    opencode) title="OpenCode" ;;
    *) agent=claude; title="Claude Code" ;;
esac

exec ptyxis --new-window --title="Teman Ngoding – $title" -x "/usr/local/bin/teman-ngoding-run $agent"
