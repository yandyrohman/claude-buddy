#!/bin/bash
# Buka Claude Code sebagai root dengan IS_SANDBOX=1.
# Dipakai oleh "Claude Buddy" (~/.local/share/applications/io.claude.buddy.desktop).

cd "$HOME" 2>/dev/null || cd /

sudo env \
    IS_SANDBOX=1 \
    HOME=/root \
    PATH="/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin" \
    COLORTERM="${COLORTERM:-truecolor}" \
    /root/.local/bin/claude "$@"
status=$?

if [ "$status" -ne 0 ]; then
    echo
    read -rp "Claude keluar dengan kode $status. Tekan Enter untuk menutup..."
fi
