[Desktop Entry]
Type=Application
Name=Teman Ngoding
GenericName=Teman ngoding AI (root)
Comment=Buka Claude Code, Gemini CLI, Codex, atau OpenCode sebagai root bersama maskotnya
Exec=/usr/local/bin/teman-ngoding-launch
Icon=teman-ngoding
Terminal=false
Categories=Development;
Keywords=claude;gemini;codex;opencode;ai;buddy;ngoding;sudo;root;
StartupNotify=false
Actions=claude;gemini;codex;opencode;

[Desktop Action claude]
Name=Buka Claude Code
Exec=/usr/local/bin/teman-ngoding-launch claude

[Desktop Action gemini]
Name=Buka Gemini CLI
Exec=/usr/local/bin/teman-ngoding-launch gemini

[Desktop Action codex]
Name=Buka Codex CLI
Exec=/usr/local/bin/teman-ngoding-launch codex

[Desktop Action opencode]
Name=Buka OpenCode
Exec=/usr/local/bin/teman-ngoding-launch opencode
